<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="PresentMon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel PresentMon">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- A simple drag surface avoids the SDK TitleBar crash on early minimization. -->
        <Grid x:Name="AppTitleBar" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0"
                        VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="Intel PresentMon" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Auto" OpenPaneLength="220"
                        CompactModeThresholdWidth="680" ExpandedModeThresholdWidth="900"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneOpen="True" SelectionChanged="Navigation_SelectionChanged"
                        PaneOpened="Navigation_PaneChanged" PaneClosed="Navigation_PaneChanged"
                        DisplayModeChanged="Navigation_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" AutomationProperties.AutomationId="NavOverview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Loadout" Tag="Loadout" AutomationProperties.AutomationId="NavLoadout">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Settings" />
                <NavigationViewItem Content="Overlay" Tag="Overlay" AutomationProperties.AutomationId="NavOverlay">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="OutlineStar" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Data processing" Tag="Data" AutomationProperties.AutomationId="NavData">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Capture" Tag="Capture" AutomationProperties.AutomationId="NavCapture">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Camera" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logging" Tag="Logging" AutomationProperties.AutomationId="NavLogging">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other" Tag="Other" AutomationProperties.AutomationId="NavOther">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About" AutomationProperties.AutomationId="NavAbout">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel x:Name="AppearancePanel" Spacing="6" Margin="12,12,12,16" Visibility="Collapsed">
                    <TextBlock Text="Appearance" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="AppearanceSelector" SelectedIndex="2"
                              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AppearanceSelector"
                              AutomationProperties.Name="Appearance" SelectionChanged="Appearance_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid x:Name="PageLayout" Padding="28,20,28,12" RowSpacing="12" SizeChanged="PageLayout_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PageTitle" Text="Overview" Style="{ThemeResource TitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="PageDescription" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <InfoBar x:Name="ConnectionNotice" Grid.Row="1" IsClosable="False"
                         Severity="Informational" AutomationProperties.AutomationId="ConnectionStatus" />
                <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True"
                         Severity="Warning" AutomationProperties.AutomationId="Notification" />
                <Grid Grid.Row="3">
                    <UserControl x:Name="PageContent">
                        <Grid x:Name="ContentHost" />
                    </UserControl>
                    <ProgressRing x:Name="Loading" IsActive="True" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="Loading PresentMon" />
                </Grid>
            </Grid>
        </NavigationView>
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnSpacing="20" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProcessStatus" Text="No application selected" TextTrimming="CharacterEllipsis"
                           FontSize="12" AutomationProperties.AutomationId="ProcessStatus" />
                <TextBlock x:Name="CaptureStatus" Grid.Column="1" Text="Capture: idle" FontSize="12"
                           AutomationProperties.AutomationId="CaptureStatus" />
                <TextBlock x:Name="OverlayStatus" Grid.Row="1" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="OverlayStatus" />
                <TextBlock x:Name="RateStatus" Grid.Row="1" Grid.Column="1" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="RateStatus" />
            </Grid>
        </Border>
    </Grid>
</Window>
