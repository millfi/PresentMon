<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Services/StartupOptions.cs" Link="Services/StartupOptions.cs" />
    <ProjectReference Include="../PresentMonUI.Core/PresentMonUI.Core.csproj" />
    <None Include="../Assets/Presets/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="NativeFixtures/*.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="NativeFixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
