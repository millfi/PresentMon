<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{3C80B001-E165-4E0E-A92D-5767CF4FB1F8}</ProjectGuid>
    <RootNamespace>PresentMon.UI</RootNamespace>
    <ProjectName>PresentMonUI</ProjectName>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <AppContainerApplication>false</AppContainerApplication>
    <DesktopCompatible>true</DesktopCompatible>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType Condition="'$(PresentMonMsix)'!='true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(PresentMonMsix)'=='true'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(PresentMonMsix)'!='true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(PresentMonMsix)'=='true'">false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize Condition="'$(PresentMonMsix)'=='true'">false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(PresentMonMsix)'=='true'">false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <EnableNativePackageReferenceSupport>true</EnableNativePackageReferenceSupport>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <MinimalCoreWin>true</MinimalCoreWin>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>PresentMonUI</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\$(Configuration)\ui\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\build\obj\PresentMonUICpp-$(Platform)-$(Configuration)\</IntDir>
    <OutDir Condition="'$(PresentMonMsix)'=='true'">$(MSBuildThisFileDirectory)..\..\build\$(Configuration)\msix-ui\</OutDir>
    <IntDir Condition="'$(PresentMonMsix)'=='true'">$(MSBuildThisFileDirectory)..\..\build\obj\PresentMonUICpp-$(Platform)-$(Configuration)-MSIX\</IntDir>
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <VcpkgEnabled>false</VcpkgEnabled>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <ForcedIncludeFiles>pch.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>/bigobj /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;WINRT_LEAN_AND_MEAN;DISABLE_XAML_GENERATED_MAIN;_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING;_SILENCE_CXX20_U8PATH_DEPRECATION_WARNING;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\..\vcpkg_installed\x64-windows-static\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
      <AdditionalDependencies>shell32.lib;shlwapi.lib;dwmapi.lib;pdh.lib;ole32.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <ApplicationDefinition Include="App.xaml" />
    <Midl Include="MainWindow.idl;ThinAcrylicBackdrop.idl" />
    <Page Include="MainWindow.xaml" />
    <ClInclude Include="**\*.h" Exclude="obj\**;Tests\**" />
    <ClCompile Include="pch.cpp"><PrecompiledHeader>Create</PrecompiledHeader><ForcedIncludeFiles></ForcedIncludeFiles></ClCompile>
    <ClCompile Include="App.xaml.cpp" />
    <ClCompile Include="main.cpp" />
    <ClCompile Include="XamlGenerated.cpp"><CompilerIteration>XamlGenerated</CompilerIteration></ClCompile>
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <ClCompile Include="MainWindow.xaml.cpp;ThinAcrylicBackdrop.cpp" />
    <ClCompile Include="Core\*.cpp;Interop\*.cpp;Services\*.cpp;Views\*.cpp;Tests\UiSmoke.cpp" />
    <Manifest Include="app.manifest" />
    <Content Include="Assets\AppIcon.ico;Assets\AppIcon.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ExportMsixFramework" AfterTargets="Build" Condition="'$(PresentMonMsix)'=='true'">
    <ItemGroup>
      <PresentMonFramework Include="@(AppxPackageRegistration)" Condition="'%(AppxPackageRegistration.Architecture)'=='x64' and '%(AppxPackageRegistration.WindowsAppSDK)'=='true'" />
    </ItemGroup>
    <Error Condition="'@(PresentMonFramework)'==''" Text="The Windows App SDK framework package was not resolved." />
    <WriteLinesToFile File="$(OutDir)framework-package.txt" Lines="@(PresentMonFramework->'%(FullPath)')" Overwrite="true" />
  </Target>
  <Target Name="RemoveDuplicateNativeInitializers" BeforeTargets="WarnCompileDuplicatedFilename;ClCompile">
    <RemoveDuplicates Inputs="@(ClCompile)"><Output TaskParameter="Filtered" ItemName="UniqueCompile" /></RemoveDuplicates>
    <ItemGroup><ClCompile Remove="@(ClCompile)" /><ClCompile Include="@(UniqueCompile)" /></ItemGroup>
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.Filename)'=='XamlTypeInfo.g'">
        <ForcedIncludeFiles>pch.h;$(ProjectDir)MainWindow.xaml.h</ForcedIncludeFiles>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
